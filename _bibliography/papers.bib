@article{ruishengzhang2025intention,
  abbr={EAAI},
  preview={Hierarchical Intention Recognition.png},
  title={Hierarchical intention recognition framework in intelligent human-computer interactions for helicopter and drone collaborative wildfire rescue missions},
  author={Ruisheng, Zhang and Xuyi, Qiu and Jichen, Han and Hang, Wu and Minglang, Li and Xiaozhou*, Zhou},
  abstract={Intention recognition is the prerequisite and foundation for achieving intelligent human-computer interaction (IHCI). In complex task scenarios, human intentions often exhibit hierarchical and context-related characteristics. In this paper, we propose a hierarchical intention recognition framework suitable for complex tasks, aiming to infer multilevel intentions from the lowest-level data such as human behaviour, machine and environmental information. The framework's usability was validated via a case study of helicopter and drone collaborative wildfire rescue missions. First, task analysis was employed to extract the intention structure among high-level task intentions, low-level interaction intentions, and feature data. Flight simulation data from 80 complete trials conducted by 16 participants were subsequently collected. Finally, reliable recognition of interaction intentions and task intentions was achieved via a one-dimensional convolutional neural network (1D-CNN) + bidirectional long short-term memory (Bi-LSTM) neural networks and a dynamic Bayesian network (DBN). The highest recognition accuracies for interaction intentions and task intentions were 94.57% and 97.33%, respectively. The methods and results of this study provide a novel perspective for human intention recognition in complex tasks and offer methodological guidance and support for intelligent adaptive interfaces and IHCI in complex task scenarios.},
  journal={Engineering Applications of Artificial Intelligence},
  volume = {143},
  pages = {110037},
  year={2025},
  issn = {0952-1976},
  html = {https://www.sciencedirect.com/science/article/pii/S0952197625000375},
  doi = {10.1016/j.engappai.2025.110037},
  url = {https://www.sciencedirect.com/science/article/pii/S0952197625000375},
  pdf={Hierarchical-Human-Computer-Intention-Recognition.pdf},
  video={https://drive.google.com/file/d/1t7iyEmOGsWwPB3_iopdPN-OPjZ9kg0JG/view?usp=sharing},
  selected={true}
}

@article{ruishengzhang2025beyonddeskvr,
  abbr={BIT},
  preview={BeyondDeskVR.png},
  title={BeyondDeskVR: an extended virtual hand interaction system in virtual reality},
  author={Ruisheng, Zhang and Xiaozhou*, Zhou},
  abstract={As virtual reality (VR) technology advances, the use of VR scenarios and applications is becoming increasingly prevalent, and the fatigue issues associated with existing mid-air hand interactions are becoming more pronounced. To alleviate fatigue in VR interactions, we developed a desktop interaction system, BeyondDeskVR. Designed for seamless integration with mid-air hand interaction in seated VR work environments, the system enables portable interaction input and mode switching. By extending virtual hand interactions to the desktop space, the system could be used on any desktop. We utilised infrared laser projection for desktop gesture recognition and achieved seamless transitions between desktop gesture interactions and mid-air hand interactions in typical three-dimensional scenarios, including pointing and selection, user interface interaction, and object manipulation. We conducted a comprehensive evaluation of the BeyondDeskVR gesture interaction system and mid-air hand interaction using a pointing selection task, assessing their performance in terms of subjectivity, performance, and fatigue. The results indicate that the BeyondDeskVR system has high user acceptance, significantly lower fatigue than does mid-air hand interaction, and comparable interaction efficiency and accuracy. Integrating this system with mid-air hand interaction can effectively reduce fatigue in VR interactions and enhance the overall VR experience.},
  journal={Behaviour & Information Technology},
  year={2025},
  html = {https://www.tandfonline.com/doi/full/10.1080/0144929X.2025.2469669?src=exp-la#d1e221},
  doi = {10.1080/0144929X.2025.2469669},
  url = {https://www.tandfonline.com/doi/full/10.1080/0144929X.2025.2469669?src=exp-la#d1e221},
  pdf={BeyondDeskVR.pdf},
  video={https://drive.google.com/file/d/15m0nlETw7DChDeTUgcwCsFU1kUZ_uF2U/view?usp=sharing},
  selected={true}
}

@article{ruishengzhang2026hfes,
  abbr={HFES},
  preview={hfes2026_ruisheng.png},
  title={Visual Guidance in Dynamic Search: How Augmented Reality Cue Properties Shape Performance},
  author={Amelia*, Warden and Ruisheng, Zhang},
  abstract={Visual search is critical in many real-world tasks, from soldiers identifying hazards to drivers locating people or objects in complex environments. Augmented reality head-mounted displays (AR-HMDs) can aid in search tasks by overlaying visual guidance directly on the user’s field-of-view, but it is still unclear which cue properties are most effective during dynamic search, especially when automated cues error. This study examined how AR cue properties shape search performance in a large, naturalistic 3D environment. Thirty-five participants completed a virtual reality (VR) search-on-the-move task (STOM) with simulated AR cues that varied in spatial precision, cue configuration, and reliability. Compared with an unaided search, reliable cues substantially improved performance. Dual cues also improved performance compared with single cues, regardless of whether targets were located within or outside the participant’s central line of sight. However, when cues erred there were clear performance costs. These findings suggest that AR guidance can support dynamic search, but cue reliability and cue properties should be carefully considered.},
  journal={Proceedings of the Human Factors and Ergonomics Society Annual Meeting},
  year={2026},
  selected={true}
}

@article{ruishengzhang2026visualsearch,
  abbr={IJHCI},
  preview={hihc2026_baijie.png},
  title={Visual Search Interference from the Eyes' Effector Role in VR Selection: The Impact of Pointing Modality and Information Density},
  author={Baijie, Wang and Ruisheng, Zhang and Junyu, Zhu and Xiaozhou*, Zhou},
  abstract={Gaze-based and hand-based multimodal interactions have emerged as key points of focus in virtual reality (VR) selection research. However, few studies have examined the inevitable visual search phase in target selection, which may influence the performance of gaze-based and hand-based pointing modalities. In this study, thirty participants searched for and selected the targets among distractors using gaze-based and hand-based pointing across two levels of visual information density. The sequential task phases of visual search and pointing-selection were examined, with both task performance and eye movements recorded. The results showed that hand-based pointing outperformed gaze-based pointing, primarily due to the hand modality’s superior performance during the visual search phase. Although both methods relied on the eyes for visual search, they produced different gaze patterns, suggesting that using the eyes as effectors disrupts natural eye behavior and visual processing. These findings provide empirical support and cognitive insight for selecting interaction modalities in VR environments.},
  journal={International Journal of Human-Computer Interaction},
  year={2026},
  html = {https://www.tandfonline.com/doi/full/10.1080/10447318.2026.2621283},
  doi = {10.1080/10447318.2026.2621283},
  url = {https://www.tandfonline.com/doi/full/10.1080/10447318.2026.2621283},
  pdf={https://www.tandfonline.com/doi/epdf/10.1080/10447318.2026.2621283?needAccess=true},
  selected={true}
}




